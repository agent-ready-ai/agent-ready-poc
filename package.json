{
  "name": "agent-ready-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-ready static site demo deployed end-to-end on Cloudflare.",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "eleventy && node scripts/emit-md-alternates.js",
    "dev": "eleventy --serve",
    "validate": "node scripts/validate.js",
    "lighthouse": "bash scripts/lighthouse.sh",
    "a11y": "node scripts/a11y.js",
    "scan": "node scripts/scan.js",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@axe-core/puppeteer": "^4.10.0",
    "chrome-launcher": "^1.1.0",
    "conventional-changelog-cli": "^5.0.0",
    "lighthouse": "^12.0.0",
    "prettier": "^3.0.0",
    "puppeteer-core": "^23.0.0"
  }
}
