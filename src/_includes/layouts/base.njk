<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or site.name }}</title>
    {% if description %}<meta name="description" content="{{ description }}" />{% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    {% if page.url != "/404.html" %}
    <link rel="alternate" type="text/markdown" href="{{ page.url }}index.md" />
    {% endif %}
    <meta property="og:title" content="{{ title or site.name }}" />
    {% if description %}<meta property="og:description" content="{{ description }}" />{% endif %}
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content="{{ site.url }}/assets/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content="{{ site.url }}/assets/og.png" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }} feed" href="/feed.xml" />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <script src="/assets/js/webmcp.js" defer></script>
    {% include "partials/analytics.njk" %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "{{ site.url }}/#organization",
            "name": "{{ site.name }}",
            "url": "{{ site.url }}",
            "description": "{{ site.description }}",
            "founder": { "@id": "{{ site.url }}/#builder" },
            "publisher": { "@id": "https://www.anthropic.com/#organization" }
          },
          {
            "@type": "Person",
            "@id": "{{ site.url }}/#builder",
            "name": "{{ site.builder.name }}",
            "description": "{{ site.builder.description }}",
            "worksFor": { "@id": "https://www.anthropic.com/#organization" },
            "knowsAbout": [
              "Static site generation",
              "Cloudflare Pages",
              "JSON-LD entity graphs",
              "WCAG 2.1 AA accessibility",
              "Build-system automation",
              "AI adoption in skilled-trades businesses"
            ],
            "sameAs": [
              {%- for s in site.builder.sameAs %}
              "{{ s }}"{% if not loop.last %},{% endif %}
              {%- endfor %}
            ]
          },
          {
            "@type": "Organization",
            "@id": "https://www.anthropic.com/#organization",
            "name": "{{ site.publisher.name }}",
            "url": "{{ site.publisher.url }}",
            "sameAs": [
              {%- for s in site.publisher.sameAs %}
              "{{ s }}"{% if not loop.last %},{% endif %}
              {%- endfor %}
            ]
          },
          {
            "@type": "WebSite",
            "@id": "{{ site.url }}/#website",
            "url": "{{ site.url }}",
            "name": "{{ site.name }}",
            "publisher": { "@id": "{{ site.url }}/#organization" },
            "inLanguage": "en"
          },
          {
            "@type": "WebPage",
            "@id": "{{ site.url }}{{ page.url }}",
            "url": "{{ site.url }}{{ page.url }}",
            "name": "{{ title or site.name }}",
            {% if description %}"description": "{{ description }}",{% endif %}
            "isPartOf": { "@id": "{{ site.url }}/#website" },
            "inLanguage": "en",
            "author": { "@id": "{{ site.url }}/#builder" },
            "publisher": { "@id": "{{ site.url }}/#organization" },
            "speakable": {
              "@type": "SpeakableSpecification",
              "cssSelector": ["h1", ".tldr", "blockquote"]
            }
          }{% if article %},
          {
            "@type": "Article",
            "@id": "{{ site.url }}{{ page.url }}#article",
            "headline": "{{ title or site.name }}",
            {% if description %}"description": "{{ description }}",{% endif %}
            "url": "{{ site.url }}{{ page.url }}",
            "mainEntityOfPage": { "@id": "{{ site.url }}{{ page.url }}" },
            "author": { "@id": "{{ site.url }}/#builder" },
            "publisher": { "@id": "{{ site.url }}/#organization" },
            "inLanguage": "en",
            "isPartOf": { "@id": "{{ site.url }}/#website" },
            "datePublished": "{{ page.date.toISOString() }}",
            "dateModified": "{{ page.date.toISOString() }}",
            "image": "{{ site.url }}/assets/og.png"
          }{% endif %}{% if howTo %},
          {
            "@type": "HowTo",
            "@id": "{{ site.url }}{{ page.url }}#howto",
            "name": {{ howTo.name | jsonInHtml | safe }},
            {% if howTo.description %}"description": {{ howTo.description | jsonInHtml | safe }},{% endif %}
            {% if howTo.totalTime %}"totalTime": "{{ howTo.totalTime }}",{% endif %}
            "step": [
              {%- for s in howTo.step %}
              {
                "@type": "HowToStep",
                "position": {{ loop.index }},
                "name": {{ s.name | jsonInHtml | safe }},
                "text": {{ s.text | jsonInHtml | safe }}{% if s.url %},
                "url": "{{ site.url }}{{ s.url }}"{% endif %}
              }{% if not loop.last %},{% endif %}
              {%- endfor %}
            ]
          }{% endif %}{% if page.url != "/" %},
          {
            "@type": "BreadcrumbList",
            "@id": "{{ site.url }}{{ page.url }}#breadcrumb",
            "itemListElement": [
              {%- for crumb in page.url | breadcrumbs(site.url) %}
              {
                "@type": "ListItem",
                "position": {{ crumb.position }},
                "name": {{ crumb.name | jsonInHtml | safe }},
                "item": "{{ crumb.item }}"
              }{% if not loop.last %},{% endif %}
              {%- endfor %}
            ]
          }{% endif %}{% if service %},
          {
            "@type": "Service",
            "@id": "{{ site.url }}{{ page.url }}#service",
            "name": {{ service.name | jsonInHtml | safe }},
            {% if description %}"description": {{ description | jsonInHtml | safe }},{% endif %}
            "provider": { "@id": "{{ site.url }}/#organization" },
            "serviceType": "AI implementation",
            "areaServed": "United States"{% if service.framework %},
            "additionalProperty": {
              "@type": "PropertyValue",
              "name": "Framework",
              "value": {{ service.framework | jsonInHtml | safe }}
            }{% endif %}
          }{% endif %}{% if faqs %},
          {
            "@type": "FAQPage",
            "@id": "{{ site.url }}{{ page.url }}#faq",
            "mainEntity": [
              {%- for faq in faqs %}
              {
                "@type": "Question",
                "name": {{ faq.q | jsonInHtml | safe }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | jsonInHtml | safe }} }
              }{% if not loop.last %},{% endif %}
              {%- endfor %}
            ]
          }{% endif %}
        ]
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header>
      <div class="masthead">
        <a class="wordmark" href="/" aria-label="{{ site.name }} — home">{{ site.shortName }}</a>
        {% include "partials/nav.njk" %}
      </div>
    </header>
    <main id="main">
      {{ content | safe }}
    </main>
    <footer>
      <p>&copy; {{ site.name }}</p>
    </footer>
  </body>
</html>
