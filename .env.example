CLOUDFLARE_API_TOKEN=cfat_replace_with_your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=replace_with_your_cloudflare_account_id

# Optional: enables Probe's live "Explain with AI" summary (NVIDIA NIM,
# OpenAI-compatible). Get a key at build.nvidia.com. In production this is a
# Pages environment variable, never committed. Leave unset for zero-token mode.
NVIDIA_API_KEY=nvapi_replace_with_your_nvidia_api_key
